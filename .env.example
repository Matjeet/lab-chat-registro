# ---------------------------------------------------------------------------
#  Variables de entorno del microservicio chat-registro
# ---------------------------------------------------------------------------
#  Uso:
#    cp .env.example .env      # y ajusta los valores para tu entorno
#
#  - `./gradlew bootRun` carga .env automáticamente (ver build.gradle).
#  - Docker:  docker run --env-file .env chat-registro
#  - Los tests NO usan .env (corren siempre sobre H2 en memoria).
#  - En producción/CI las variables las inyecta el entorno, no este fichero.
#
#  Todas tienen un valor por defecto en application.yml; aquí solo se
#  sobreescriben. El esquema y el usuario se crean con db/bootstrap.sql.
# ---------------------------------------------------------------------------

# --- Base de datos (MySQL centralizada) ---
DB_URL=jdbc:mysql://localhost:3306/chat_registro?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=chat_registro_svc
DB_PASSWORD=chat_registro_pw

# --- JPA / Hibernate ---
# validate = Hibernate solo comprueba el esquema (lo gestiona Flyway).
# Valores posibles: validate | none | update | create | create-drop
JPA_DDL_AUTO=validate

# --- Firebase Auth (proveedor de identidad externo) ---
# Descarga la clave de cuenta de servicio desde la consola de Firebase
# (Configuracion del proyecto > Cuentas de servicio > Generar nueva clave privada) y guarda
# el JSON fuera del repo (este .env ya esta gitignoreado; el JSON NUNCA se versiona).
FIREBASE_ENABLED=true
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json

# --- gRPC (unico protocolo de este servicio para el registro, ver README.md) ---
GRPC_SERVER_ENABLED=true
GRPC_SERVER_PORT=9090
